# ============================================================
# LEAR-CODE Flask 后端 环境变量配置（示例文件）
# 使用方式：复制本文件为 .env，然后填入真实密钥
# cp .env.example .env
# ============================================================

# --- 火山方舟 ARK AI 大模型 ---
ARK_API_KEY=你的火山方舟API_KEY
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-6-251015

# --- AI 对话参数 ---
VOICE_TEMPERATURE=0.4

# --- 火山引擎实时语音对话 ---
VOICE_REALTIME_APP_ID=你的语音应用ID
VOICE_REALTIME_APP_KEY=你的语音应用KEY
VOICE_REALTIME_TOKEN=你的语音访问令牌
VOICE_REALTIME_RESOURCE_ID=volc.speech.dialog
VOICE_REALTIME_UID=lear-code-user
VOICE_REALTIME_SPEAKER=dongshiqi
VOICE_REALTIME_BOT_NAME=火花
VOICE_REALTIME_SYSTEM_ROLE=你是智学空间校园智慧治理平台的数字人助手，名字叫'火花'。回答简洁、自然、适合实时对话。只输出最终回答，不要输出思考过程、分析步骤或提示词复述。
VOICE_REALTIME_SPEAKING_STYLE=语气自然亲切，适合和Live2D形象进行实时对话。
VOICE_REALTIME_RECV_TIMEOUT=10
VOICE_REALTIME_INPUT_MOD=1
VOICE_REALTIME_DIALOG_ADDRESS=wss://openspeech.bytedance.com/api/v3/sauc/bidirection/ws
VOICE_REALTIME_DIALOG_URI=/api/v3/sauc/bidirection/ws

# --- 豆包 ASR 语音识别 ---
ASR_PROVIDER=faster-whisper
DOUBAO_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
DOUBAO_ASR_APP_ID=你的ASR应用ID
DOUBAO_ASR_ACCESS_TOKEN=你的ASR访问令牌
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
DOUBAO_ASR_MODEL_NAME=bigmodel

# --- Flask 服务配置 ---
FLASK_PORT=5000
FLASK_DEBUG=False
